datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum Status {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String        // Encrypted with bcrypt
  role         Role          @default(EMPLOYEE)
  department   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  complaints   Complaint[]

  @@map("users")
}

model Resource {
  id           String        @id @default(uuid())
  name         String
  category     String       
  description  String?
  capacity     Int?
  location     String?
  isAvailable        Boolean       @default(true)
  isUnderMaintenance Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  complaints   Complaint[]

  @@map("resources")
}

model Reservation {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  status     Status   @default(PENDING)
  purpose    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([resourceId, startTime, endTime])
  @@map("reservations")
}

model Complaint {
  id          String            @id @default(uuid())
  resourceId  String
  resource    Resource          @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String            @default("Physical Damage")
  description String
  severity    ComplaintSeverity @default(MEDIUM)
  status      ComplaintStatus   @default(OPEN)
  adminNotes  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([resourceId])
  @@index([userId])
  @@index([status])
  @@map("complaints")
}
